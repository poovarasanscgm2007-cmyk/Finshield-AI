# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finshield_ai"

# JWT Secret for role-based auth
JWT_SECRET="replace-with-strong-random-secret"

# LLM API Key for extraction & copilot
LLM_API_KEY="MY_LLM_API_KEY"

# Confidence threshold below which extracted fields require human verification
EXTRACTION_CONFIDENCE_THRESHOLD=0.80

# Directory for uploaded invoice documents
UPLOAD_DIR="uploads"

# Express server port
PORT=4000

# CORS configuration (comma-separated origins or * for open/development)
# Production example: "https://finshield-ai-mocha.vercel.app"
CORS_ORIGIN="https://finshield-ai-mocha.vercel.app"
