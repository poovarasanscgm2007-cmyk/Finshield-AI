{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./frontend/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "vite.config.ts",
    "backend/src/**/*.ts",
    "backend/scripts/**/*.ts",
    "backend/tests/**/*.ts",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "database/**/*.ts",
    "sample-data/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "backend/dist", "frontend/dist"]
}
