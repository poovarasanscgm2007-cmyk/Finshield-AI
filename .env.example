# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finshield_ai"

# Authentication secret (used in Phase 2+)
JWT_SECRET="replace-with-strong-random-secret"

# LLM API Key (Gemini / LLM field extraction & AI Copilot in later phases)
LLM_API_KEY="MY_LLM_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backend server port
PORT=4000

# Application URL (used in AI Studio / deployment)
APP_URL="http://localhost:3000"
