# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finshield_ai"

# Authentication secret
JWT_SECRET="replace-with-strong-random-secret"

# LLM API Key (Gemini API key for invoice extraction & AI Copilot)
LLM_API_KEY="MY_LLM_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Phase 3 Extraction & Upload settings
EXTRACTION_CONFIDENCE_THRESHOLD=0.80
UPLOAD_DIR="uploads"

# Backend server port
PORT=4000

# Application URL
APP_URL="http://localhost:3000"

# CORS configuration (comma-separated origins or * for open/development)
# Production example: "https://finshield-ai-mocha.vercel.app"
CORS_ORIGIN="https://finshield-ai-mocha.vercel.app"

# Frontend production API URL (set in Vercel project settings)
# Production example: "https://finshield-ai-backend.onrender.com"
VITE_API_URL=""
